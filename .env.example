# ── Database ──────────────────────────────────────────────────────────
POSTGRES_DB=musicatte
POSTGRES_USER=musicatte
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Backend ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_MINUTES=1440
BACKEND_PORT=8010

# Upload ceiling. Phone photos routinely land between 4 and 12 MB, so do not
# lower this without also expecting "file too large" complaints. The scanner
# reads the value from /api/ocr/limits, so it is stated in exactly one place.
MAX_UPLOAD_BYTES=16777216

# Uploaded files are deleted after this many hours.
UPLOAD_RETENTION_HOURS=48

# ── OCR ───────────────────────────────────────────────────────────────
# Seconds to wait for one page of recognition.
HOMR_TIMEOUT_SECONDS=600
OCR_MAX_PAGES=15

# Preprocessed variants to try per page. Each one costs a full recognition
# pass and the most musically consistent result wins, so 2 buys accuracy at
# double the time; 1 is fastest; 3 adds an unprocessed fallback.
OCR_VARIANTS=2

# HOMR commit or tag to build. Pinned so recognition accuracy cannot change
# between two builds of the same commit of this repository.
HOMR_REF=v0.6.0

# ── Frontend ──────────────────────────────────────────────────────────
VITE_API_URL=https://api.musicatte.com
FRONTEND_PORT=8020

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://musicatte.com
